APP_NAME=ThreatDetect API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://admin:admin123@localhost:27017/threatdetect?authSource=admin
MONGODB_DB=threatdetect
VIDEO_SOURCE=0
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.4
ANOMALY_THRESHOLD=0.45
EVENT_THRESHOLD=0.7
PRE_EVENT_SECONDS=6
POST_EVENT_SECONDS=4
CLIP_OUTPUT_DIR=./storage/clips
FRAME_WIDTH=1280
FRAME_HEIGHT=720
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
MAILER_SERVICE_URL=http://localhost:5001/send-alert
ALERT_RECIPIENTS=security@example.com
ALERT_COOLDOWN_SECONDS=300
